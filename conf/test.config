/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the full pipeline on two small synthetic samples (assets/test) with the SENTRY
    models in models/. The data are simulated, so the predictions are not meaningful.

    Use as follows:
        nextflow run nerettilab/SENTRY -profile test,conda --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal synthetic dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data
    input                  = "${projectDir}/assets/test/samplesheet.csv"
    threshold_combinations = "${projectDir}/assets/test/threshold_combinations.json"
    column1                = 'age'
    column2                = 'cell_type'
    sample_column          = 'orig.ident'
}
